---
import DemoHeader from '../components/DemoHeader.astro';
import InspectScenario from '../components/InspectScenario.astro';

const steps = [
  'Start review mode on the home page.',
  'Add a comment to one visible target.',
  'Stop recording, then open this page.',
  'Confirm only workflow comments appear here.',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Workflow Route | Inspect Clip Demo</title>
  </head>
  <body>
    <main class="page-shell">
      <DemoHeader />

      <section class="route-hero" data-demo-target="workflow-hero">
        <p class="eyebrow">Route test</p>
        <h1>Workflow page</h1>
        <p>
          Use this route to verify that the review bar survives navigation while
          copied context and highlighted comments stay scoped to this page.
        </p>
      </section>

      <section class="route-grid" aria-label="Workflow route targets">
        <InspectScenario
          eyebrow="Route context"
          title="Workflow card"
          body="Comment this card, move to another demo page, then return here to confirm the comment comes back."
          tone="green"
        />

        <article class="route-panel" data-demo-target="workflow-panel">
          <p class="eyebrow">Checklist</p>
          <h2>Page switch path</h2>
          <ol>
            {steps.map((step) => <li>{step}</li>)}
          </ol>
          <button type="button" class="route-action">Workflow action</button>
        </article>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --page: oklch(96% 0.012 262);
    --paper: oklch(99% 0.006 262);
    --ink: oklch(20% 0.035 264);
    --muted: oklch(49% 0.032 264);
    --line: oklch(86% 0.022 264);
    --violet: oklch(52% 0.19 291);
    --green: oklch(57% 0.14 155);
    --amber: oklch(67% 0.15 72);
    --shadow-soft: 0 22px 60px oklch(28% 0.055 264 / 0.14);
    --shadow-tight: 0 10px 30px oklch(28% 0.055 264 / 0.1);
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-width: 320px;
    background:
      linear-gradient(90deg, oklch(88% 0.018 264 / 0.45) 1px, transparent 1px),
      linear-gradient(0deg, oklch(88% 0.018 264 / 0.45) 1px, transparent 1px),
      linear-gradient(145deg, var(--page), oklch(96% 0.018 155));
    background-size: 44px 44px, 44px 44px, auto;
    color: var(--ink);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  button,
  a {
    font: inherit;
  }

  .page-shell {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: 18px 0 72px;
  }

  .route-hero {
    display: grid;
    gap: 12px;
    margin: 28px 0 22px;
    padding: 30px;
    border: 1px solid oklch(100% 0 0 / 0.68);
    border-radius: 8px;
    background: var(--paper);
    box-shadow: var(--shadow-tight);
  }

  .eyebrow {
    margin: 0;
    color: var(--green);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    letter-spacing: 0;
    line-height: 1.05;
  }

  h1 {
    max-width: 12ch;
    font-size: clamp(42px, 7vw, 84px);
  }

  .route-hero p:last-child {
    max-width: 62ch;
    margin: 0;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.7;
  }

  .route-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: 18px;
  }

  .route-panel {
    padding: 22px;
    border: 1px solid oklch(100% 0 0 / 0.66);
    border-radius: 8px;
    background: var(--paper);
    box-shadow: var(--shadow-tight);
  }

  .route-panel ol {
    display: grid;
    gap: 10px;
    margin: 22px 0;
    padding-left: 22px;
    color: var(--muted);
    line-height: 1.55;
  }

  .route-action {
    padding: 11px 14px;
    border: 1px solid oklch(18% 0.03 264);
    border-radius: 7px;
    background: var(--ink);
    color: var(--paper);
    cursor: pointer;
    font-weight: 750;
  }

  @media (max-width: 760px) {
    .route-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
